{
  "name": "nanosandbox",
  "version": "0.2.0",
  "description": "Lightweight cross-platform sandbox for secure code execution",
  "main": "index.js",
  "types": "index.d.ts",
  "license": "MIT",
  "keywords": [
    "sandbox",
    "container",
    "security",
    "isolation",
    "cross-platform",
    "napi-rs",
    "rust"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Erio-Harrison/nanosandbox.git"
  },
  "napi": {
    "binaryName": "nanosandbox",
    "targets": [
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-pc-windows-msvc"
    ]
  },
  "engines": {
    "node": ">= 18"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3"
  },
  "scripts": {
    "artifacts": "napi artifacts",
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "prepublishOnly": "napi prepublish -t npm",
    "test": "node --test tests/",
    "universal": "napi universal",
    "version": "napi version"
  },
  "files": [
    "index.js",
    "index.d.ts"
  ],
  "optionalDependencies": {
    "nanosandbox-darwin-x64": "0.2.0",
    "nanosandbox-darwin-arm64": "0.2.0",
    "nanosandbox-linux-x64-gnu": "0.2.0",
    "nanosandbox-linux-arm64-gnu": "0.2.0",
    "nanosandbox-win32-x64-msvc": "0.2.0"
  }
}
