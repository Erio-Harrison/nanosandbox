# Type stubs for the native module. tests/test_stubs.py checks they list what the module has;
# docs/API.md has the semantics, under the same names.

from typing import List, Optional, TypedDict

KB: int
MB: int
GB: int

class NetworkRefusal(TypedDict):
    """A destination the ``allow_network`` proxy didn't connect a run to."""

    host: str
    port: int
    # not-allowed, denied, non-public-address, host-mismatch, unreachable, timed-out
    reason: str
    # a deny entry's reason, else None
    detail: Optional[str]
    attempts: int

class DeniedPath(TypedDict):
    """A file access the sandbox refused (with ``report_denials``; macOS only so far)."""

    path: str
    operation: str
    count: int

class Permission:
    """Read-only or read-write, for ``SandboxBuilder.bind``. Linux only."""

    READ_ONLY: Permission
    READ_WRITE: Permission

class SandboxBuilder:
    """Fluent builder; every method returns the builder. A builder is consumed by ``build``."""

    def __init__(self) -> None: ...
    # Filesystem
    def read_only(self, path: str) -> SandboxBuilder: ...
    def writable(self, path: str) -> SandboxBuilder: ...
    def private_tmp(self, size_bytes: int = ...) -> SandboxBuilder: ...
    def no_private_tmp(self) -> SandboxBuilder: ...
    def deny_read(self, path: str) -> SandboxBuilder: ...
    def hide_home(self) -> SandboxBuilder: ...
    def working_dir(self, path: str) -> SandboxBuilder: ...
    # Linux only
    def bind(self, source: str, target: str, permission: Permission) -> SandboxBuilder: ...
    def tmpfs(self, path: str, size_bytes: int) -> SandboxBuilder: ...
    def rootfs(self, path: str) -> SandboxBuilder: ...
    # Resources
    def memory_limit(self, bytes: int) -> SandboxBuilder: ...
    def cpu_limit(self, cpus: float) -> SandboxBuilder: ...
    def wall_time_limit(self, seconds: float) -> SandboxBuilder: ...
    def cpu_time_limit(self, seconds: float) -> SandboxBuilder: ...
    def max_pids(self, n: int) -> SandboxBuilder: ...
    def max_file_size(self, bytes: int) -> SandboxBuilder: ...
    def max_open_files(self, n: int) -> SandboxBuilder: ...
    def max_output(self, bytes: int) -> SandboxBuilder: ...
    # Network
    def no_network(self) -> SandboxBuilder: ...
    def host_network(self) -> SandboxBuilder: ...
    def allow_network(self, domains: List[str]) -> SandboxBuilder: ...
    def allow_private_destinations(self) -> SandboxBuilder: ...
    def deny_network(self, entries: List[str]) -> SandboxBuilder: ...
    def deny_network_with_reason(self, entry: str, reason: str) -> SandboxBuilder: ...
    def require_host_match(self) -> SandboxBuilder: ...
    def allow_trustd(self) -> SandboxBuilder: ...
    # Audit
    def report_denials(self) -> SandboxBuilder: ...
    # Linux only: identity and syscall filter
    def seccomp(self, enabled: bool) -> SandboxBuilder: ...
    def uid(self, uid: int) -> SandboxBuilder: ...
    def gid(self, gid: int) -> SandboxBuilder: ...
    def host_uid(self, uid: int) -> SandboxBuilder: ...
    def host_gid(self, gid: int) -> SandboxBuilder: ...
    # Environment
    def env(self, key: str, value: str) -> SandboxBuilder: ...
    def clear_env(self, clear: bool) -> SandboxBuilder: ...
    # macOS only: whether the host's /tmp etc. stay writable; False leaves only private $TMPDIR
    def shared_tmp(self, shared: bool) -> SandboxBuilder: ...
    # Linux only
    def hostname(self, name: str) -> SandboxBuilder: ...
    def build(self) -> Sandbox: ...

class Sandbox:
    @staticmethod
    def builder() -> SandboxBuilder: ...
    @staticmethod
    def data_analysis(input_dir: str, output_dir: str) -> SandboxBuilder: ...
    @staticmethod
    def code_judge(code_dir: str) -> SandboxBuilder: ...
    @staticmethod
    def agent_executor(workspace: str) -> SandboxBuilder: ...
    @staticmethod
    def interactive(workspace: str) -> SandboxBuilder: ...
    def run(self, cmd: str, args: List[str]) -> ExecutionResult: ...
    def run_with_input(
        self, cmd: str, args: List[str], stdin: Optional[bytes] = None
    ) -> ExecutionResult: ...
    def id(self) -> str: ...
    def platform(self) -> str: ...

class ExecutionResult:
    @property
    def stdout(self) -> str: ...
    @property
    def stderr(self) -> str: ...
    @property
    def exit_code(self) -> int: ...
    @property
    def wall_time_seconds(self) -> float: ...
    @property
    def cpu_time_seconds(self) -> Optional[float]: ...
    @property
    def peak_memory_bytes(self) -> Optional[int]: ...
    @property
    def killed_by_timeout(self) -> bool: ...
    @property
    def killed_by_oom(self) -> bool: ...
    @property
    def killed_by_tmp_limit(self) -> bool: ...
    @property
    def killed_by_cpu_limit(self) -> bool: ...
    @property
    def output_truncated(self) -> bool: ...
    @property
    def proc_isolated(self) -> bool: ...
    @property
    def signal(self) -> Optional[int]: ...
    @property
    def blocked_hosts(self) -> List[str]: ...
    @property
    def network_refusals(self) -> List[NetworkRefusal]: ...
    @property
    def denied_paths(self) -> List[DeniedPath]: ...
    def success(self) -> bool: ...
    def failure_reason(self) -> Optional[str]: ...

def is_platform_supported() -> bool: ...
def platform_name() -> str: ...
